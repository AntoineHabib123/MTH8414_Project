% Electricity bill: energy price (cents/kWh) per period, demand charge (cents per kW of daily peak), grid limit (kW)
price = [6, 6, 6, 6, 16, 16, 16, 16, 16, 16, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 16, 16, 16, 16, 16, 16, 16, 16, 9, 9, 9, 9, 9, 9, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6];
demandCharge = 40;
gridLimit = 250;

% Chargers: type 1 = slow, type 2 = fast. Power (kW), daily cost of one charger (cents), cost of one plug-in operation (cents)
nTypes = 2;
power = [50, 150];
chargerCost = [1500, 4000];
plugCost = 300;

% Depot stays (Part 3). A stay follows each trip: the bus is in the depot during periods arrival..departure-1
% and must recover 'energy' kWh (the consumption of the trip it has just completed).
nStays = 7;
stayBus = [1, 1, 2, 2, 3, 4, 4];
arrival = [10, 32, 23, 38, 27, 15, 44];
departure = [23, 49, 28, 49, 49, 29, 49];
energy = [150, 225, 300, 150, 300, 150, 225];
